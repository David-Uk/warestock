# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:Database@91@localhost:5432/warestock

# ── Auth: JWT ───────────────────────────────────────────────────────
# Use RS256 in production: set both JWT_PRIVATE_KEY and JWT_PUBLIC_KEY (PEM strings)
# Fall back to HS256 if only SECRET_KEY is set
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15         # short-lived; refreshed by refresh token
REFRESH_TOKEN_EXPIRE_DAYS=7

# RS256 (production): generate with: openssl genrsa -out private.pem 2048
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Per-User Encryption (UEK) ────────────────────────────────────────
# 32-byte hex string used to wrap each user's DEK in the session token response.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: changing this value invalidates ALL active user sessions — all users must re-login.
SESSION_WRAP_SECRET=CHANGE_ME_use_python_secrets_token_hex_32

# PBKDF2 iterations for KEK derivation from user password.
# Increase for higher security at the cost of login latency (~100ms at 100000 on modern hardware).
PBKDF2_ITERATIONS=100000

# ── Platform ─────────────────────────────────────────────────────────
APP_ENV=development                     # development | production
PLATFORM_SUPERADMIN_EMAIL=superadmin@warestock.local
PLATFORM_SUPERADMIN_PASSWORD=CHANGE_ME_dev_only

CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ── AI (Google Gemini) ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Storage (local dev; swap for S3/GCS in prod) ─────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── Email (invitation / password reset) ──────────────────────────────
MAIL_USERNAME=no-reply@warestock.local
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=no-reply@warestock.local
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ── Observability ─────────────────────────────────────────────────────
SENTRY_DSN=
